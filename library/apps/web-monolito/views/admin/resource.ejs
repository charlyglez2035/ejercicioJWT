<%- include('../partials/header') %><p class="eyebrow">Administracion</p><h1><%= title %></h1><form class="inline-form" method="post" action="/admin/<%= key %>"><input name="name" placeholder="Nuevo nombre" required><% if (descriptionColumn) { %><input name="description" placeholder="Descripcion"><% } %><button class="button">Agregar</button></form><div class="admin-list"><% rows.forEach(row => { %><form method="post" action="/admin/<%= key %>/<%= row[idColumn] %>"><input name="name" value="<%= row[nameColumn] %>" required><% if (descriptionColumn) { %><input name="description" value="<%= row.description || '' %>"><% } %><button class="button secondary">Guardar</button><button class="text-danger" formaction="/admin/<%= key %>/<%= row[idColumn] %>/delete">Eliminar</button></form><% }) %></div><%- include('../partials/footer') %>
