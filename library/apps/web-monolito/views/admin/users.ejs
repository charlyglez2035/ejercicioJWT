<link rel="stylesheet" href="/admin.css"><%- include('../partials/header') %><section class="admin-hero"><div><p class="eyebrow">Administracion / Usuarios</p><h1>Usuarios registrados</h1><p class="lede">Crea cuentas, actualiza permisos y mantén el acceso bajo control.</p></div><a class="button secondary" href="/admin">Volver al panel</a></section><section class="user-create"><div><p class="eyebrow">Nueva cuenta</p><h2>Crear usuario</h2><p>Las cuentas creadas desde aquí quedan verificadas y pueden entrar de inmediato.</p></div><form class="user-form create-form" method="post" action="/admin/users"><label>Nombre completo<input name="full_name" required></label><label>Usuario<input name="username" required></label><label>Correo<input type="email" name="email" required></label><label>Contraseña<input type="password" name="password" required minlength="8"></label><label>Rol<select name="role"><option value="customer">Cliente</option><option value="admin">Administrador</option></select></label><button class="button" type="submit">Crear usuario</button></form></section><section class="user-list-head"><div><p class="eyebrow">Directorio</p><h2>Usuarios actuales</h2></div><span><%= users.length %> cuentas</span></section><div class="admin-list"><% users.forEach(user => { %><form class="user-row" method="post" action="/admin/users/<%= user.user_id %>"><div class="user-avatar"><%= String(user.full_name || user.username || '?').charAt(0).toUpperCase() %></div><div class="user-fields"><label>Nombre<input name="full_name" value="<%= user.full_name %>" required></label><label>Usuario<input name="username" value="<%= user.username %>" required></label><label>Correo<input type="email" name="email" value="<%= user.email %>" required></label><label>Nueva contraseña<input type="password" name="password" placeholder="Sin cambios"></label></div><div class="user-actions"><label>Rol<select name="role"><option value="customer" <%= user.role === 'customer' ? 'selected' : '' %>>Cliente</option><option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrador</option></select></label><button class="button secondary" type="submit">Guardar</button><button class="text-danger" type="submit" formaction="/admin/users/<%= user.user_id %>/delete">Eliminar</button></div></form><% }) %></div><%- include('../partials/footer') %>
