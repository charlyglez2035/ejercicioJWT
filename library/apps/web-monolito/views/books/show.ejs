<%- include('../partials/header') %><article class="detail"><div class="cover large"><span><%= book.category_name %></span><strong><%= book.title.slice(0, 1) %></strong></div><div><p class="eyebrow"><%= book.format_name %> · ISBN <%= book.isbn %></p><h1><%= book.title %></h1><p class="lede"><%= book.authors || 'Autor pendiente' %></p><div class="price">$<%= Number(book.price).toFixed(2) %> <small><%= book.stock %> en stock</small></div><p><%= book.genres || 'Sin genero asignado' %></p><% if (currentUser && currentUser.role === 'admin') { %><a class="button" href="/books/<%= encodeURIComponent(book.isbn) %>/edit">Editar libro</a> <form class="inline" method="post" action="/books/<%= encodeURIComponent(book.isbn) %>/delete"><button class="button danger">Eliminar</button></form><% } %></div></article><section class="content-section"><h2>Conceptos definidos</h2><div class="concepts"><% book.concepts.forEach(concept => { %><div><h3><%= concept.name %></h3><p><%= concept.definition %></p></div><% }) %></div></section><section class="content-section"><h2>Imagenes</h2><div class="images"><% book.images.forEach(image => { %><figure><img src="<%= image.image_url %>" alt="<%= image.alt_text || book.title %>"><% if (currentUser && currentUser.role === 'admin') { %><form method="post" action="/books/<%= encodeURIComponent(book.isbn) %>/images/<%= image.image_id %>"><input name="alt_text" value="<%= image.alt_text || '' %>" placeholder="Texto alternativo"><input type="number" name="display_order" value="<%= image.display_order %>" min="1"><label class="check"><input type="checkbox" name="is_cover" <%= image.is_cover ? 'checked' : '' %>> Portada</label><button class="button secondary">Actualizar</button></form><form method="post" action="/books/<%= encodeURIComponent(book.isbn) %>/images/<%= image.image_id %>/delete"><button class="text-danger">Eliminar</button></form><% } %></figure><% }) %></div><% if (currentUser && currentUser.role === 'admin') { %><form class="upload" method="post" enctype="multipart/form-data" action="/books/<%= encodeURIComponent(book.isbn) %>/images"><input type="file" name="image" accept="image/*" required><input name="alt_text" placeholder="Texto alternativo"><button class="button secondary">Subir imagen</button></form><% } %></section><%- include('../partials/footer') %>
