<%- include('../partials/header') %><p class="eyebrow">Administracion</p><h1>Usuarios registrados</h1><div class="admin-list"><% users.forEach(user => { %><form method="post" action="/admin/users/<%= user.user_id %>"><input name="full_name" value="<%= user.full_name %>" required><input name="username" value="<%= user.username %>" required><input type="email" name="email" value="<%= user.email %>" required><input type="password" name="password" placeholder="Nueva contraseña"><select name="role"><option value="customer" <%= user.role === 'customer' ? 'selected' : '' %>>Cliente</option><option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrador</option></select><button class="button secondary">Guardar</button><button class="text-danger" formaction="/admin/users/<%= user.user_id %>/delete">Eliminar</button></form><% }) %></div><%- include('../partials/footer') %>
