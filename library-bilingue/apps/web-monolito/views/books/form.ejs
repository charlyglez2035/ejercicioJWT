<%- include('../partials/header') %><section class="form-head"><p class="eyebrow">Catalogo / Edicion</p><h1><%= title %></h1></section><form class="book-form" method="post" action="/books/<%= book.isbn || 'new' %>"><label>ISBN<input name="isbn" value="<%= book.isbn || '' %>" required maxlength="17"></label><label>Titulo<input name="title" value="<%= book.title || '' %>" required></label><label>Año de publicacion<input type="number" name="publication_year" value="<%= book.publication_year || '' %>"></label><label>Precio<input type="number" step="0.01" min="0" name="price" value="<%= book.price || '' %>" required></label><label>Stock<input type="number" min="0" name="stock" value="<%= book.stock || 0 %>" required></label><label>Formato<select name="format_id" required><% formats.forEach(item => { %><option value="<%= item.format_id %>" <%= item.format_id == book.format_id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Categoria<select name="category_id" required><% categories.forEach(item => { %><option value="<%= item.category_id %>" <%= item.category_id == book.category_id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><fieldset><legend>Autores</legend><% authors.forEach(item => { %><label class="check"><input type="checkbox" name="author_ids" value="<%= item.author_id %>" <%= book.authors && book.authors.includes(item.name) ? 'checked' : '' %>><%= item.name %></label><% }) %></fieldset><fieldset><legend>Generos</legend><% genres.forEach(item => { %><label class="check"><input type="checkbox" name="genre_ids" value="<%= item.genre_id %>" <%= book.genres && book.genres.includes(item.name) ? 'checked' : '' %>><%= item.name %></label><% }) %></fieldset><fieldset><legend>Conceptos y definiciones</legend><% concepts.forEach(item => { const concept = (book.concepts || []).find(value => value.concept_id == item.concept_id); %><label class="check"><input type="checkbox" name="concept_ids" value="<%= item.concept_id %>" <%= concept ? 'checked' : '' %>><%= item.name %></label><textarea name="definition_<%= item.concept_id %>" placeholder="Definicion para este libro"><%= concept ? concept.definition : '' %></textarea><% }) %></fieldset><button class="button" type="submit">Guardar libro</button> <a class="button secondary" href="/books">Cancelar</a></form><%- include('../partials/footer') %>
