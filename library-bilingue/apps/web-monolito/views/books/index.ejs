<%- include('../partials/header') %><section class="catalog-head"><div><p class="eyebrow">Coleccion curada</p><h1>Historias para llevar.</h1><p class="lede">Busca entre libros, autores y mundos cuidadosamente elegidos.</p></div><% if (currentUser && currentUser.role === 'admin') { %><a class="button" href="/books/new">+ Nuevo libro</a><% } %></section><form class="search" method="get"><input name="q" value="<%= typeof query !== 'undefined' ? query : '' %>" placeholder="Buscar por titulo o ISBN"><button class="button secondary">Buscar</button></form><section class="book-grid"><% books.forEach(book => { %><article class="book-card"><div class="cover"><span><%= book.category_name %></span><strong><%= book.title.slice(0, 1) %></strong></div><div class="book-info"><p class="eyebrow"><%= book.format_name %> · <%= book.isbn %></p><h2><a href="/books/<%= encodeURIComponent(book.isbn) %>"><%= book.title %></a></h2><p><%= book.authors || 'Autor pendiente' %></p><div class="book-meta"><b>$<%= Number(book.price).toFixed(2) %></b><span><%= book.stock %> disponibles</span></div></div></article><% }) %></section><% if (!books.length) { %><div class="empty"><h2>No hay resultados.</h2><p>Prueba otra busqueda o agrega el primer libro.</p></div><% } %><%- include('../partials/footer') %>
